# ArgoCD Configuration
# Replace these with your actual ArgoCD instance details

# ArgoCD Server URL (without trailing slash)
ARGOCD_SERVER_URL=https://your-argocd-server.com

# ArgoCD Authentication - Choose one method:

# Method 1: Username/Password Authentication
ARGOCD_USERNAME=admin
ARGOCD_PASSWORD=your-argocd-password

# Method 2: Token Authentication (alternative to username/password)
# Get token by: argocd auth login --username admin --password yourpass
# Then: argocd auth token
ARGOCD_AUTH_TOKEN=argocd.token=your-auth-token-here

# GitHub Token (for catalog integration)
GITHUB_TOKEN=your-github-token

# Other authentication providers (optional)
AUTH_GITHUB_CLIENT_ID=your-github-oauth-client-id
AUTH_GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# Backend secrets
BACKEND_SECRET=your-backend-secret-key